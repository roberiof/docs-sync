# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude API — used only by /api/ai route handler (server-side).
ANTHROPIC_API_KEY=your-anthropic-key

# y-websocket server (collaboration). Public: reaches the browser.
NEXT_PUBLIC_YWS_URL=ws://localhost:1234
